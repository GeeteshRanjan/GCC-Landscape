node_modules/
.next/
out/
build/
dist/

# env
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.pem

# typescript
*.tsbuildinfo
next-env.d.ts

# import scratch output — the published dataset lives in data/, tracked
data/*.report.json

# Authoring-time downloads. `scripts/build_dot_map.py` caches a 13 MB Natural
# Earth geojson here and commits only the two path strings it derives. The source
# is public domain and re-downloadable, so committing it would be 13 MB of
# permanent history buying nothing.
.cache/

# Impeccable's own working directory. Critique snapshots are a local backlog
# `/impeccable polish` reads; the skill itself lives under .kiro/skills, which is
# already untracked. Nothing here is a source of truth.
.impeccable/

# test fixtures and reports
tests/browser/.tmp/
playwright-report/
test-results/

# Vendored third-party agent skills: 300 files, 2.1 MB, three upstream packs, one
# LICENSE between them. Not committed, because git history is forever and this is
# a client repo — redistributing other people's work into it is the hard decision
# to reverse, whereas re-adding these is a one-line change.
#
# Nothing is lost: .kiro/skill-sources.json records each pack's repo and pinned
# commit, and the documented update path is re-cloning rather than editing in
# place. Steering, hooks and settings ARE tracked — they are ours and they are
# what makes a session reproducible.
.kiro/skills/

# Stray design exports dropped at the repo root. Brand art belongs in
# assets/brand/ (source) or public/brand/ (adapted output), never here — a 7 MB
# Figma export committed by a careless `git add .` is in the history forever.
/*.svg
# Working reference material, held locally on purpose. Same reasoning as the
# root-SVG rule above: these are inputs we read while building, not part of the
# product, and one careless `git add .` puts them in the history forever.
#
# `Customer Logos/` is the raw client hand-off; the marks the app actually serves
# are the adapted copies in public/logos/, which ARE tracked. Anything matching
# the critique pattern is an external review, transcribed into the style lock's
# critique section where its conclusions belong.
Customer Logos/
Critic and Suggestions.md

# Local working handover, not the steering one. `.kiro/steering/handoff.md` is the
# tracked, bounded handoff; this is a long-form scratch copy kept on disk only.
docs/handover.md

# Commercial font binaries. Moderat is licensed per-project and the licence for an
# embedded tool is unsettled — committing the files is the redistribution decision
# git history makes permanent, exactly as with the vendored skills above. The pair
# on disk is also Light + Regular only, so every Bold heading would be synthesised;
# the Hanken Grotesk stand-in has real weights and is the better render until a
# licensed woff2 set with Medium and Bold arrives. See handoff, blocked item 8.
public/fonts/

# The domain-fill working file. Generated by `npm run domains:template`, consumed by
# `npm run domains:import`, and reproducible from the dataset at any time — so it is a
# transient artefact rather than a source. `data/dataset.json` is the committed truth.
data/domains.csv
data/domains-unmatched.csv
