# Admin environment. Copy to .env.local for development; set the same keys in the
# host's environment for a deployment. .env.local is gitignored; this file is not,
# so it must never carry a real value.

# ---------------------------------------------------------------------------
# Auth. Both values come from `npm run admin:hash` — run it and paste the two
# lines it prints. The password itself is never stored; if it is lost, run the
# script again to set a new one.
#
# The hash uses `:` separators and base64url, not the conventional `$` and
# base64, because dotenv expands `$N` as a variable reference and would deliver
# a truncated hash. Do not reformat it.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=
# At least 32 characters. Rotating this logs the admin out everywhere.
ADMIN_SESSION_SECRET=

# Optional second factor (TOTP). Mint one with `npm run admin:hash -- --totp`,
# scan the printed otpauth:// URI into an authenticator app, then set it here.
#
# Worth setting for a real deployment. The login rate limiter lives in process
# memory, so several instances mean several budgets and a cold start clears them —
# it cannot bound a distributed guessing attempt, and a second factor makes that
# moot. Leave blank to keep login password-only.
#
# Confirm a code works before closing your current session: a wrong secret here
# locks you out of admin, and the only way back is editing this value.
ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Where a publish writes. Reads always come from the local data/dataset.json;
# only the write path is selected here.
#
#   github  commits data/dataset.json through the GitHub API, which triggers the
#           rebuild that makes the change live. The production setting.
#   fs      writes to this machine's filesystem. Correct for local development
#           and for a self-hosted deployment with a real, persistent disk.
#
# Left unset, development falls back to `fs`. Left unset in production,
# publishing refuses to start rather than writing somewhere the next deploy
# discards.
# ---------------------------------------------------------------------------
GCC_DATA_STORE=fs

# Required when GCC_DATA_STORE=github.
# owner/name — the same repo this code is deployed from.
GCC_GITHUB_REPO=
# A token with contents:write on that repo. Never logged, never sent to the browser.
GCC_GITHUB_TOKEN=
# Optional. Defaults below are used when blank.
GCC_GITHUB_BRANCH=main
GCC_GITHUB_DATASET_PATH=data/dataset.json
# Optional commit author. GitHub falls back to the token's own identity.
GCC_GITHUB_AUTHOR_NAME=
GCC_GITHUB_AUTHOR_EMAIL=

# Optional. Overrides where the filesystem store reads and writes. Used by the
# import and verify scripts; rarely needed otherwise.
# GCC_DATASET_PATH=

# ---------------------------------------------------------------------------
# Public screens. Both are NEXT_PUBLIC_, so they reach the browser — never put
# anything here that is not already public.
#
# Both are optional and both have working fallbacks, so the tool ships before
# either decision is made. Note that Next inlines NEXT_PUBLIC_ values at build
# time: changing one needs a redeploy, not just a restart.
# ---------------------------------------------------------------------------

# The FALLBACK link for both screens' closing call to action. There is no form on
# the public screens and nothing is collected, so this is the whole conversion
# path. Defaults to https://www.ansr.com/ — correct, if less specific than the
# real landing page will be.
#
# Admin now sets a link PER RESULT SCREEN under Site copy, so each one can carry its
# own UTM tagging and the two presses can be told apart. Those win where they are
# filled; this is what a screen whose field is left blank uses. So it is still worth
# setting when there is one landing page and no tagging, and it needs no data edit.
# NEXT_PUBLIC_GCC_CTA_URL=

# Brandfetch Logo API client ID, for the company marks on the peer comparison cards.
#
# NEXT_PUBLIC_ because the value is public by construction: it appears in the query
# string of an image request in the visitor's browser, which is what the provider's own
# documentation specifies. It is a rate-limiting and attribution identifier, not a
# secret — but it is still config, so it never gets committed.
#
# UNSET IS THE SAFE DEFAULT AND WHAT PRODUCTION SHOULD SHIP UNTIL TRADEMARK USE IS
# SETTLED WITH ANSR. With no value: no third-party request is made, the CSP allows no
# extra origin, and every peer card draws the company name alone — which is exactly how
# the screen rendered before marks existed.
#
# Note the provider forbids programmatic retrieval of the images: these are hotlinked
# and nothing in this repo ever downloads one. See the peer-card rule in
# .kiro/steering/project.md.
# NEXT_PUBLIC_GCC_BRANDFETCH_CLIENT_ID=

# The origin the tool posts its height to, for the parent page to size the
# iframe. Defaults to `*`, which is safe here because the payload is a single
# integer describing our own layout — there is nothing to leak. Pin it to the
# hosting page's origin once that is known.
# NEXT_PUBLIC_GCC_FRAME_TARGET_ORIGIN=https://www.ansr.com

# Extra origins allowed to frame the public tool, beyond ansr.com. Space-separated
# BARE origins: scheme + host + optional port, no path, no trailing slash. A `*.`
# wildcard needs at least two labels after it (`https://*.example.com`, never
# `https://*.com`). Anything else fails the build. Unset adds nothing. /admin is never
# frameable whatever this says. Parsed by src/lib/frame-ancestors.ts.
#
# Read at build time: on Vercel, set it for Production and REDEPLOY. An
# `http://localhost:…` entry only lets a page on the viewer's own machine frame the
# tool, so a deployed portfolio needs its real origin listed as well.
# GCC_FRAME_ANCESTORS_EXTRA=http://localhost:5173 https://your-portfolio.example
